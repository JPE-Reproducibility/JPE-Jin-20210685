@article{Chiappori2000,
abstract = {The first goal of this paper is to provide a simple and general test of the presence of asymmetric information in contractual relation- ships within a competitive context. We also argue that insurance data are particularly well suited to such empirical investigations. To illustrate this claim, we use data on contracts and accidents to investigate the extent of asymmetric information in the French market for automobile insurance. Using various parametric and nonparametric methods, we find no evidence for the presence of asymmetric information in this market.},
author = {Chiappori, Pierre Andre and Salanie, Bernard},
doi = {10.1086/262111},
